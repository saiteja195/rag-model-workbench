# ============================================
# RAG Model Workbench — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# LLM Provider: "openai", "gemini", or "ollama"
LLM_PROVIDER=openai

# OpenAI (Standard)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (Optional override)
# If provided, the system will use the AzureOpenAI client and OPENAI_MODEL acts as the deployment name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
